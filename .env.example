# Copy to .env for local use. Never commit real secrets.
# For published apps, set these in Cursor Secrets (strong unique values only).

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE"

# Required: at least 32 random characters (not a placeholder phrase).
AUTH_SECRET=

# Optional one-time account bootstrap. Disabled unless ALLOW_SEED_USERS=1.
# Passwords must be ≥16 characters and must not be common placeholders.
# ALLOW_SEED_USERS=1
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
