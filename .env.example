# Local only — never commit real secrets. Published apps use Cursor Secrets.

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE"

# Required: ≥32 random characters (not a placeholder phrase).
AUTH_SECRET=

# Optional bootstrap (disabled unless ALLOW_SEED_USERS=1).
# Passwords must be ≥16 characters and not common placeholders.
# ALLOW_SEED_USERS=1
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
