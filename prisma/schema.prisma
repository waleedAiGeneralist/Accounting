generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/** Shared login throttle counters (cross-instance). */
model LoginAttempt {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(0)
  resetAt DateTime
  updatedAt DateTime @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum VoucherType {
  CASH_RECEIPT
  CASH_PAYMENT
  SALE
  PURCHASE
  JOURNAL
  EXPENSE
}

enum StockCategory {
  RICE
  KIRYANA
  BARDANA
}

enum StockUnit {
  KG
  MAUND
  BAG
  PCS
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  nameUrdu  String
  type      AccountType
  isActive  Boolean     @default(true)
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  lines     VoucherLine[]
}

model Party {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  type      PartyType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vouchers  Voucher[]
}

model Voucher {
  id           String          @id @default(cuid())
  date         DateTime
  type         VoucherType
  narration    String
  partyId      String?
  party        Party?          @relation(fields: [partyId], references: [id])
  isReversal   Boolean         @default(false)
  reversesId   String?         @unique
  reverses     Voucher?        @relation("VoucherReversal", fields: [reversesId], references: [id])
  reversedBy   Voucher?        @relation("VoucherReversal")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lines        VoucherLine[]
  stockMoves   StockMovement[]
}

model VoucherLine {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     Float   @default(0)
  credit    Float   @default(0)

  @@index([voucherId])
  @@index([accountId])
}

model StockItem {
  id        String          @id @default(cuid())
  name      String
  category  StockCategory
  unit      StockUnit
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  movements StockMovement[]
}

model StockMovement {
  id        String    @id @default(cuid())
  itemId    String
  item      StockItem @relation(fields: [itemId], references: [id])
  voucherId String
  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  qtyIn     Float     @default(0)
  qtyOut    Float     @default(0)
  rate      Float     @default(0)

  @@index([itemId])
  @@index([voucherId])
}
